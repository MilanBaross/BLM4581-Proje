@page
@model KampusPortali.Pages.KayitModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_GirisLayout";
}

<h1 class="giris-baslik">Kayıt Ol</h1>
<p class="giris-alt-baslik">Portalı kullanmak için hesap oluşturun.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6">
            <label asp-for="Girdi.Ad" class="form-label"></label>
            <input asp-for="Girdi.Ad" class="form-control" autocomplete="given-name" />
            <span asp-validation-for="Girdi.Ad" class="text-danger small"></span>
        </div>
        <div class="col-12 col-sm-6">
            <label asp-for="Girdi.Soyad" class="form-label"></label>
            <input asp-for="Girdi.Soyad" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="Girdi.Soyad" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Girdi.OgrenciNo" class="form-label"></label>
        <div class="ikonlu-girdi">
            <i class="bi bi-person-vcard"></i>
            <input asp-for="Girdi.OgrenciNo" class="form-control" placeholder="Örn: 200100111" inputmode="numeric" />
        </div>
        <span asp-validation-for="Girdi.OgrenciNo" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Girdi.Email" class="form-label"></label>
        <div class="ikonlu-girdi">
            <i class="bi bi-envelope"></i>
            <input asp-for="Girdi.Email" class="form-control" placeholder="ornek@ogrenci.ankara.edu.tr" autocomplete="email" />
        </div>
        <span asp-validation-for="Girdi.Email" class="text-danger small"></span>
    </div>

    <div class="row g-3">
        <div class="col-12 col-sm-6">
            <label asp-for="Girdi.Sifre" class="form-label"></label>
            <input asp-for="Girdi.Sifre" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Girdi.Sifre" class="text-danger small"></span>
        </div>
        <div class="col-12 col-sm-6">
            <label asp-for="Girdi.SifreTekrar" class="form-label"></label>
            <input asp-for="Girdi.SifreTekrar" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Girdi.SifreTekrar" class="text-danger small"></span>
        </div>
    </div>
    <p class="form-text mb-4">Şifre en az 8 karakter olmalı, en az bir küçük harf ve bir rakam içermelidir.</p>

    <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
</form>

<p class="giris-yonlendirme">
    Zaten hesabınız var mı? <a asp-page="/Giris" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Giriş Yapın</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
