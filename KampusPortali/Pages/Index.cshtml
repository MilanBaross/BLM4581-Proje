@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="d-flex align-items-center gap-3 mt-4 mb-4">
    <img src="~/images/au_logo.png" alt="AÜ Hub Logo" style="width: 56px; height: auto;">
    <div>
        <h1 class="h4 fw-bold text-primary mb-0">Kampüs Modülleri</h1>
        <p class="text-muted mb-0">Kullanmak istediğiniz modülü seçin.</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var modul in Moduller.Tumu)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm modul-karti">
                <div class="card-body">
                    <div class="fs-2 mb-2" aria-hidden="true">@modul.Ikon</div>
                    <h2 class="h5 card-title">
                        <a asp-page="@modul.Sayfa" class="stretched-link text-decoration-none">@modul.Baslik</a>
                    </h2>
                    <p class="card-text text-muted">@modul.Aciklama</p>
                </div>
            </div>
        </div>
    }
</div>
