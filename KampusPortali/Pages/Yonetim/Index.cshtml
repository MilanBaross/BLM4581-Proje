@page
@model KampusPortali.Pages.Yonetim.IndexModel
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="sayfa-baslik">
    <h1>Yönetim Paneli</h1>
    <p>Portal içeriği, kayıtlı kullanıcılar ve rolleri</p>
</div>

<a asp-page="/Yonetim/Duyurular" class="modul-karti mb-4">
    <span class="modul-ikon"><i class="bi bi-megaphone"></i></span>
    <span class="modul-metin">
        <span class="modul-baslik">Duyuru Yönetimi</span>
        <span class="modul-aciklama">Ana sayfadaki duyuruları ekleyin, düzenleyin veya silin.</span>
    </span>
    <i class="bi bi-chevron-right modul-ok"></i>
</a>

<h2 class="bolum-baslik">Kullanıcılar</h2>

<div class="panel-kart p-0 table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>E-posta</th>
                <th>Öğrenci No</th>
                <th>Rol</th>
                <th>Kayıt Tarihi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model.Kullanicilar)
            {
                <tr>
                    <td>@k.AdSoyad</td>
                    <td>@k.Email</td>
                    <td>@(k.OgrenciNo ?? "-")</td>
                    <td><span class="badge @(k.Roller.Contains(Roller.Yonetici) ? "rozet-yonetici" : "rozet-kullanici")">@k.Roller</span></td>
                    <td>@k.KayitTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
