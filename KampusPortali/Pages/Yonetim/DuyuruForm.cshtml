@page
@model KampusPortali.Pages.Yonetim.DuyuruFormModel
@{
    var baslik = Model.DuzenlemeMi ? "Duyuruyu Düzenle" : "Duyuru Ekle";
    ViewData["Title"] = baslik;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Yonetim/Index">Yönetim Paneli</a></li>
        <li class="breadcrumb-item"><a asp-page="/Yonetim/Duyurular">Duyurular</a></li>
        <li class="breadcrumb-item active" aria-current="page">@baslik</li>
    </ol>
</nav>

<div class="sayfa-baslik">
    <h1>@baslik</h1>
    <p>@(Model.DuzenlemeMi ? "Duyuru bilgilerini güncelleyin." : "Ana sayfada yayınlanacak duyuruyu yazın.")</p>
</div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="panel-kart">
            <form method="post" asp-route-id="@Model.Id">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Girdi.Baslik" class="form-label"></label>
                    <div class="ikonlu-girdi">
                        <i class="bi bi-type"></i>
                        <input asp-for="Girdi.Baslik" class="form-control" placeholder="Örn: Final sınav takvimi açıklandı" />
                    </div>
                    <span asp-validation-for="Girdi.Baslik" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Girdi.Icerik" class="form-label"></label>
                    <textarea asp-for="Girdi.Icerik" class="form-control" rows="8"
                              placeholder="Duyurunun metni..."></textarea>
                    <div class="d-flex justify-content-between gap-2">
                        <span asp-validation-for="Girdi.Icerik" class="text-danger small"></span>
                        <span class="form-text mt-0 ms-auto text-nowrap" id="icerikSayac">
                            <span id="icerikUzunluk">@Model.Girdi.Icerik.Length</span> / 2000
                        </span>
                    </div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Girdi.OnemliMi" class="form-check-input" role="switch" />
                    <label asp-for="Girdi.OnemliMi" class="form-check-label">Önemli (ana sayfada en üstte gösterilir)</label>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> @(Model.DuzenlemeMi ? "Kaydet" : "Duyuruyu Ekle")
                    </button>
                    <a asp-page="/Yonetim/Duyurular" class="btn btn-outline-secondary">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // İçerik alanı için karakter sayacı; sınır aşılınca kırmızıya döner.
        (function () {
            const alan = document.getElementById('Girdi_Icerik');
            const sayac = document.getElementById('icerikSayac');
            const uzunluk = document.getElementById('icerikUzunluk');
            const sinir = 2000;

            function guncelle() {
                uzunluk.textContent = alan.value.length;
                sayac.classList.toggle('text-danger', alan.value.length > sinir);
            }

            alan.addEventListener('input', guncelle);
            guncelle();
        })();
    </script>
}
