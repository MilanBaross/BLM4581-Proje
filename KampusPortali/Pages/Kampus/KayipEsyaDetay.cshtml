@page "{id:int}"
@model KampusPortali.Pages.Kampus.KayipEsyaDetayModel
@using System.Globalization
@{
    var modul = Moduller.KayipEsya;
    var ilan = Model.Ilan;
    ViewData["Title"] = ilan.Baslik;
    var tr = new CultureInfo("tr-TR");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Ana Sayfa</a></li>
        <li class="breadcrumb-item"><a asp-page="/Kampus/KayipEsya">@modul.Baslik</a></li>
        <li class="breadcrumb-item active" aria-current="page">İlan Detayı</li>
    </ol>
</nav>

<div class="sayfa-baslik d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <h1>
            @ilan.Baslik
            @if (ilan.TeslimEdildiMi)
            {
                <span class="badge rozet-yonetici fs-6 align-middle">Teslim edildi</span>
            }
            else
            {
                <span class="badge rozet-kullanici fs-6 align-middle">Bekliyor</span>
            }
        </h1>
        <p>Bulunan eşya ilanı</p>
    </div>

    @if (Model.DuzenleyebilirMi)
    {
        <div class="d-flex gap-2">
            <a asp-page="/Kampus/KayipEsyaForm" asp-route-id="@ilan.Id" class="btn btn-outline-secondary">
                <i class="bi bi-pencil"></i> Düzenle
            </a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#silOnayi">
                <i class="bi bi-trash"></i> Sil
            </button>
        </div>
    }
</div>

<div class="panel-kart">
    <h2 class="bolum-baslik">Açıklama</h2>
    <p style="white-space: pre-line">@ilan.Aciklama</p>

    <hr />

    <dl class="row mb-0">
        <dt class="col-sm-3 form-label"><i class="bi bi-geo-alt"></i> Bulunduğu Yer</dt>
        <dd class="col-sm-9">@ilan.BulunanYer</dd>

        <dt class="col-sm-3 form-label"><i class="bi bi-calendar-event"></i> Bulunma Tarihi</dt>
        <dd class="col-sm-9">@ilan.BulunmaTarihi.ToLocalTime().ToString("d MMMM yyyy, dddd", tr)</dd>

        <dt class="col-sm-3 form-label"><i class="bi bi-person"></i> Bildiren</dt>
        <dd class="col-sm-9 mb-0">
            @(ilan.BildirenKullanici != null ? $"{ilan.BildirenKullanici.Ad} {ilan.BildirenKullanici.Soyad}" : "Bilinmiyor")
        </dd>
    </dl>
</div>

<a asp-page="/Kampus/KayipEsya" class="btn btn-link px-0 mt-3 text-decoration-none">
    <i class="bi bi-arrow-left"></i> İlanlara dön
</a>

@if (Model.DuzenleyebilirMi)
{
    <div class="modal fade" id="silOnayi" tabindex="-1" aria-labelledby="silOnayiBaslik" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="silOnayiBaslik">İlanı sil</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    "@ilan.Baslik" ilanı kalıcı olarak silinecek. Emin misiniz?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <form method="post" asp-page-handler="Sil" asp-route-id="@ilan.Id">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
