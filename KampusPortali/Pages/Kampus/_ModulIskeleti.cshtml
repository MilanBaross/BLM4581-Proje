@model Modul

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Ana Sayfa</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Baslik</li>
    </ol>
</nav>

<div class="modul-ust">
    <span class="modul-ust-ikon"><i class="bi @Model.Ikon"></i></span>
    <div>
        <h1>@Model.Baslik</h1>
        <p class="mb-0">@Model.Aciklama</p>
    </div>
</div>

<div class="panel-kart bos-durum">
    <i class="bi @Model.Ikon"></i>
    <h2>Bu modül hazırlanıyor</h2>
    <p>İçerik sonraki haftalarda eklenecek.</p>
    <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">Ana Sayfaya Dön</a>
</div>
