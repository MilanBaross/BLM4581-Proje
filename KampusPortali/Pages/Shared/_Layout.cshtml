@inject SignInManager<Kullanici> SignInManager
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AÜ Hub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KampusPortali.styles.css" asp-append-version="true" />
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="uygulama">
            <partial name="_YanMenu" />

            <div class="icerik-alani">
                <header class="mobil-ust-bar d-lg-none">
                    <button class="btn btn-ikon" type="button" data-bs-toggle="offcanvas" data-bs-target="#yanMenu"
                            aria-controls="yanMenu" aria-label="Menüyü aç">
                        <i class="bi bi-list"></i>
                    </button>
                    <a asp-page="/Index" class="marka-yazi text-white">AÜ Hub</a>
                </header>

                <main role="main" class="icerik">
                    <partial name="_BilgiMesaji" />
                    @RenderBody()
                </main>

                <footer class="alt-bilgi">
                    &copy; 2026 AÜ Hub &middot; Ankara Üniversitesi Kampüs Portalı
                </footer>
            </div>
        </div>
    }
    else
    {
        <main role="main" class="container py-5">
            <partial name="_BilgiMesaji" />
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
