@if (TempData["Bilgi"] is string bilgi)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 bilgi-mesaji" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@bilgi</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
