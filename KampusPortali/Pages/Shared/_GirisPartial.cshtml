@inject UserManager<Kullanici> UserManager
@{
    var aktifSayfa = ViewContext.RouteData.Values["page"] as string;
    var kullanici = await UserManager.GetUserAsync(User);
    var adSoyad = kullanici != null ? $"{kullanici.Ad} {kullanici.Soyad}" : User.Identity?.Name;
    var basHarf = string.IsNullOrEmpty(adSoyad) ? "?" : adSoyad.Substring(0, 1).ToUpper();
}

<div class="yan-menu-alt">
    @if (User.IsInRole(Roller.Yonetici))
    {
        <a asp-page="/Yonetim/Index" class="yan-menu-link mb-2 @(aktifSayfa == "/Yonetim/Index" ? "aktif" : "")">
            <i class="bi bi-shield-lock"></i> Yönetim Paneli
        </a>
    }

    <div class="kullanici-kutusu">
        <div class="kullanici-avatar">@basHarf</div>
        <div class="kullanici-bilgi">
            <div class="kullanici-ad">@adSoyad</div>
            <div class="kullanici-eposta">@User.Identity?.Name</div>
        </div>
        <form method="post" asp-page="/Cikis">
            <button type="submit" class="btn btn-cikis" title="Çıkış Yap" aria-label="Çıkış Yap">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </form>
    </div>
</div>
