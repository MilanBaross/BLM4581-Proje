@{
    var aktifSayfa = ViewContext.RouteData.Values["page"] as string;
}

@foreach (var modul in Moduller.Tumu)
{
    var aktif = aktifSayfa == modul.Sayfa;
    <a asp-page="@modul.Sayfa" class="yan-menu-link @(aktif ? "aktif" : "")" aria-current="@(aktif ? "page" : null)">
        <i class="bi @modul.Ikon"></i> @modul.Baslik
    </a>
}
