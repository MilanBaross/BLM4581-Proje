@page
@model KampusPortali.Pages.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img src="~/images/au_logo.png" alt="AÜ Hub Logo" style="width: 120px; height: auto;" class="mb-3">
                    <h2 class="fw-bold text-primary">AÜ Hub</h2>
                    <p class="text-muted">Kampüs Portalına Hoş Geldiniz</p>
                </div>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Girdi.KullaniciAdiVeyaEmail" class="form-label fw-semibold"></label>
                        <input asp-for="Girdi.KullaniciAdiVeyaEmail" class="form-control" placeholder="Örn: 200100111" autocomplete="username" />
                        <span asp-validation-for="Girdi.KullaniciAdiVeyaEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Girdi.Sifre" class="form-label fw-semibold"></label>
                        <input asp-for="Girdi.Sifre" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Girdi.Sifre" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <div class="form-check">
                            <input asp-for="Girdi.BeniHatirla" class="form-check-input" />
                            <label asp-for="Girdi.BeniHatirla" class="form-check-label"></label>
                        </div>
                        <a href="#" class="text-decoration-none">Şifremi Unuttum</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Giriş Yap
                    </button>
                </form>

                <p class="text-center mt-3 mb-0">
                    Hesabınız yok mu? <a asp-page="/Kayit" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Kayıt Olun</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
