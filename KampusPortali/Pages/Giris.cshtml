@page
@model KampusPortali.Pages.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img src="~/images/au_logo.png" alt="AÜ Hub Logo" style="width: 120px; height: auto;" class="mb-3">
                    <h2 class="fw-bold text-primary">AÜ Hub</h2>
                    <p class="text-muted">Kampüs Portalına Hoş Geldiniz</p>
                </div>

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Öğrenci No veya E-posta</label>
                        <input type="text" class="form-control" placeholder="Örn: 200100111" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Şifre</label>
                        <input type="password" class="form-control" placeholder="••••••••" required>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="hatirla">
                            <label class="form-check-label" for="hatirla">Beni Hatırla</label>
                        </div>
                        <a href="#" class="text-decoration-none">Şifremi Unuttum</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Giriş Yap
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>