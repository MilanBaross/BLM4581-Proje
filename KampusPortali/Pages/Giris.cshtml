@page
@model KampusPortali.Pages.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_GirisLayout";
}

<h1 class="giris-baslik">Giriş Yap</h1>
<p class="giris-alt-baslik">Öğrenci numaranız veya e-posta adresinizle giriş yapın.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Girdi.KullaniciAdiVeyaEmail" class="form-label"></label>
        <div class="ikonlu-girdi">
            <i class="bi bi-person"></i>
            <input asp-for="Girdi.KullaniciAdiVeyaEmail" class="form-control" placeholder="Örn: 200100111" autocomplete="username" />
        </div>
        <span asp-validation-for="Girdi.KullaniciAdiVeyaEmail" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Girdi.Sifre" class="form-label"></label>
        <div class="ikonlu-girdi">
            <i class="bi bi-lock"></i>
            <input asp-for="Girdi.Sifre" class="form-control" placeholder="••••••••" autocomplete="current-password" />
        </div>
        <span asp-validation-for="Girdi.Sifre" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input asp-for="Girdi.BeniHatirla" class="form-check-input" />
            <label asp-for="Girdi.BeniHatirla" class="form-check-label"></label>
        </div>
        <a href="#" class="small text-decoration-none">Şifremi Unuttum</a>
    </div>

    <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
</form>

<p class="giris-yonlendirme">
    Hesabınız yok mu? <a asp-page="/Kayit" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Kayıt Olun</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
